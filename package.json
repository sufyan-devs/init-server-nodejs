{
  "name": "init-server-nodejs",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts --ext ts --watch src",
    "build": "rimraf dist && tsc && tsc-alias",
    "start:prod": "npm run build && cross-env NODE_ENV=production node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "seed": "npm run seed:roles && npm run seed:users",
    "seed:roles": "tsx src/modules/user/seed/roles.ts",
    "seed:users": "tsx src/modules/user/seed/users.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Production-grade Node.js + TypeScript server starter",
  "dependencies": {
    "argon2": "^0.45.1",
    "axios": "^1.7.8",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "redis": "^5.11.0",
    "sharp": "^0.35.3",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.19.27",
    "@types/nodemailer": "^7.0.11",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "nodemon": "^3.1.10",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
