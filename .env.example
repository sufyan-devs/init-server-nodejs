# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — only this file.
# Production secrets belong in a vault, not in a file on the box.
#
# Every variable here is read by src/config/env.ts. A missing secret, or a number
# that is not a valid integer, stops the server at boot and names itself. Other
# values are not validated: an unset one falls back to its default.
#
# The values below are safe local-development defaults. For short lifetimes while
# testing expiry, see the TEST MODE block at the end of this file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development

# Branding used in outbound email. Set these per client; leave APP_LOGO_URL
# unset to render the name as text instead of an image.
APP_NAME=Acme
APP_LOGO_URL=
PORT=8000
# Number of proxies in front of the app. The rate limiter trusts req.ip, which is
# only correct if this matches reality. Applied only when NODE_ENV=production.
TRUSTED_PROXY_COUNT=1

# --- Database ---------------------------------------------------------------
# Required when NODE_ENV=production; development falls back to this value.
MONGO_URI=mongodb://localhost:27017/app

# --- Redis (REQUIRED) -------------------------------------------------------
# Sessions, lockout counters, rate limits and OTP all live here. The server
# refuses to start if Redis is unreachable — a server that boots without it
# looks healthy and rejects every login.
# Needs Redis >= 7.0 (the limiter uses EXPIRE ... NX).
REDIS_URL=redis://localhost:6379
# Or the discrete form instead of REDIS_URL:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=11
REDIS_CONNECTION_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# --- Secrets (REQUIRED — no fallback) ---------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs session cookies and the CSRF HMAC. Required: the server will not boot
# without it.
COOKIE_SECRET=

# --- Sessions ---------------------------------------------------------------
# Sliding lifetime. The cookie's max-age follows this unless set below.
SESSION_EXPIRY_MS=604800000
# Ceiling regardless of activity (30 days). A sliding TTL alone lets a stolen
# cookie live forever as long as it keeps being used.
SESSION_ABSOLUTE_MAX_MS=2592000000
# Live sessions (devices) per user; the oldest is evicted past this. Without a
# cap, a scripted login loop grows the set without limit.
SESSION_MAX_PER_USER=10

# --- Cookies ----------------------------------------------------------------
# Per-portal names are derived from this base: session_token_admin, _vendor, ...
# That is why an admin cookie cannot be replayed against the customer API.
COOKIE_NAME=session_token
COOKIE_DOMAIN=
# Leave blank to follow SESSION_EXPIRY_MS.
COOKIE_MAX_AGE_MS=

# --- CSRF -------------------------------------------------------------------
# Double-submit, HMAC-bound to the session id. Auth is cookie-based, so without
# this the API is forgeable cross-site. One CSRF cookie per portal, mirroring the
# session cookies. CSRF_HEADER_NAME is fed to the CORS allowlist automatically.
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token

# --- Password policy --------------------------------------------------------
# Required only when seeding with NODE_ENV=production; the seed refuses to run
# without it, because the development default is published in the docs.
SEED_ADMIN_PASSWORD=

# Length beats composition rules (NIST/OWASP): no forced symbols, no rotation.
PASSWORD_MIN_LENGTH=8
# Breached-password check via the HIBP range API (k-anonymity: only the first 5
# SHA-1 characters leave this server). Fails OPEN if HIBP is unreachable.
PASSWORD_HIBP_CHECK=true
# argon2id — OWASP's documented floor. The npm package's own defaults are higher
# (m=65536, t=3, p=4); raise these on a box with the headroom and benchmark to
# ~250-400 ms per verify. Raising them later is free: needsRehash upgrades each
# user on their next login.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# bcryptjs is still a dependency, but only to VERIFY `$2` hashes minted before
# the argon2 migration; those are re-hashed to argon2 on the owner's next login.
# It needs no config — bcrypt reads the cost out of the hash it is checking.
# Remove the dependency once no `$2` hashes remain in the users collection.

# --- Account lockout (per account, in Redis) --------------------------------
# The per-account half of login abuse. The rate limiter below owns the per-IP
# half; two account-scoped controls would make whichever trips first the only
# one that ever fires. Password reset clears a lock — it is the one recovery path.
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SECONDS=900
LOCKOUT_DURATION_SECONDS=900

# --- Rate limiting (our own Redis layer, no third-party package) ------------
# PER IP, and an IP is shared — an office, a school or a mobile carrier's CGNAT
# puts many real users behind one address. So these are looser than you might
# expect: stopping brute force against ONE account is the lockout's job.
# Fails OPEN if Redis is down: an outage must not lock everyone out.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_OTP_WINDOW_SECONDS=3600

# --- CORS -------------------------------------------------------------------
# Explicit allowlist, comma-separated. Never reflect an arbitrary origin.
# Required when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Third-party login ------------------------------------------------------
# Every provider funnels into the SAME session flow, so adding one later needs no
# database migration and no route change — see src/modules/auth/providers/.
# Google is verified by ID token against Google's public keys. Comma-separated so
# web, iOS and Android client ids can share one backend.
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_IDS=

# --- OTP / password reset ---------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_SEND_MAX_REQUESTS=5
OTP_SEND_WINDOW_MINUTES=60
OTP_VERIFY_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=5

# --- Email ------------------------------------------------------------------
# Without EMAIL_USER / EMAIL_PASSWORD no email is delivered, so OTP and reset
# codes never arrive. For local testing, a sandbox SMTP inbox (Mailtrap, Ethereal)
# catches every message without sending it to real people.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Acme <no-reply@example.com>

# ---------------------------------------------------------------------------
# TEST MODE — short lifetimes for testing expiry by hand. Development only.
# Uncomment a line to override the value set above (the later line wins).
# With these, a session dies after 2 idle minutes (any request in the second
# minute extends it), an OTP or reset code after 2 minutes, and 3 wrong
# passwords lock an account for 60 seconds.
# For a full Postman run, raise RATE_LIMIT_LOGIN_MAX to 1000 instead: the
# collection logs in many times (see README, "API testing with Postman").
# ---------------------------------------------------------------------------
# SESSION_EXPIRY_MS=120000
# SESSION_ABSOLUTE_MAX_MS=600000
# SESSION_MAX_PER_USER=3
# OTP_EXPIRY_MINUTES=2
# OTP_SEND_WINDOW_MINUTES=5
# RESET_TOKEN_EXPIRY_MINUTES=2
# LOCKOUT_MAX_ATTEMPTS=3
# LOCKOUT_WINDOW_SECONDS=60
# LOCKOUT_DURATION_SECONDS=60
# RATE_LIMIT_GLOBAL_MAX=200
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# RATE_LIMIT_REGISTER_MAX=3
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
# RATE_LIMIT_OTP_MAX=3
# RATE_LIMIT_OTP_WINDOW_SECONDS=60

